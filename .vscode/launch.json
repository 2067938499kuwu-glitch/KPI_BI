{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Trae Workspace: Launch KPI Demo",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/kpi-bi-demo",
      "preLaunchTask": "workspace: dev"
    },
    {
      "name": "Trae Workspace: Preview KPI Demo",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4173",
      "webRoot": "${workspaceFolder}/kpi-bi-demo",
      "preLaunchTask": "workspace: preview"
    },
    {
      "name": "Launch Chrome against localhost",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/kpi-bi-demo",
      "preLaunchTask": "workspace: dev"
    },
    {
      "name": "Trae Workspace: Launch KPI Demo (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/kpi-bi-demo",
      "preLaunchTask": "workspace: dev"
    }
  ]
}
